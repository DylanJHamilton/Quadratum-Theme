<div class="hero-banner"{% if section.settings.background_image %} style="background-image:url({{ section.settings.background_image | image_url }});"{% endif %}>
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'heading' %}
        <h1>{{ block.settings.text }}</h1>
      {% when 'button' %}
        <a href="{{ block.settings.link }}" class="btn">{{ block.settings.label }}</a>
    {% endcase %}
  {% endfor %}
</div>

{% schema %}
