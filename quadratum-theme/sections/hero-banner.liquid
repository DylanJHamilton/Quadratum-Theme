<section class="hero-banner" style="background-image:url({{ section.settings.background_image_url }}); background-size:cover; padding:4rem 2rem; text-align:center; color:white;">
  <div class="hero-content" style="max-width:800px; margin:0 auto;">
    {% if section.settings.heading %}
      <h1 style="font-size:2.5rem;">{{ section.settings.heading }}</h1>
    {% endif %}
    
    {% if section.settings.subheading %}
      <p style="font-size:1.25rem; margin:1rem 0;">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.cta_link and section.settings.cta_label %}
      <a href="{{ section.settings.cta_link }}" class="btn" style="display:inline-block; margin-top:1.5rem; background:black; color:white; padding:0.75rem 1.5rem; border-radius:4px; text-decoration:none;">
        {{ section.settings.cta_label }}
      </a>
    {% else %}
      <p style="color:red;">Missing CTA values</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to the Playground"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "This is your Quadratum base template"
    },
    {
      "type": "text",
      "id": "background_image_url",
      "label": "Background Image URL"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Text",
      "default": "Visit Playground"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
