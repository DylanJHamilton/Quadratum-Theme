{%- comment -%}
  Blog Listing Section

  This section outputs a list of blog posts from a selected blog.  The
  merchant can control how many posts appear, how many columns are
  shown on larger screens, and which meta information should be
  displayed.  Articles are rendered as cards with an image, title,
  optional excerpt, author and publication date.  The grid is fully
  responsive and uses CSS variables to control the number of columns.
{%- endcomment -%}

{%- assign selected_blog = section.settings.blog -%}
{%- assign blog_obj = blogs[selected_blog] -%}

<div id="blog-listing-{{ section.id }}" class="blog-listing">
  {%- if section.settings.heading != blank -%}
    <h2 class="blog-listing__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if blog_obj != nil -%}
    <div class="blog-listing__grid" style="--bl-cols-desktop: {{ section.settings.posts_per_row }}; --bl-cols-mobile: 1;">
      {%- for article in blog_obj.articles limit: section.settings.posts_count -%}
        <article class="blog-listing__item">
        {%- if article.image != blank -%}
                  <a href="{{ article.url }}" class="blog-listing__image-link">
                    {{ article.image 
                      | image_url: width: 600 
                      | image_tag: 
                        class: "blog-listing__image", 
                        loading: "lazy", 
                        sizes: "(min-width: 768px) calc(100vw / " | append: section.settings.posts_per_row | append: "), 100vw", 
                        alt: article.title 
                    }}
                  </a>
          {%- endif -%}
          <div class="blog-listing__content">
            <h3 class="blog-listing__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            {%- if section.settings.show_date or section.settings.show_author -%}
              <p class="blog-listing__meta">
                {%- if section.settings.show_date -%}
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %d, %Y' }}</time>
                {%- endif -%}
                {%- if section.settings.show_date and section.settings.show_author -%}
                  &nbsp;•&nbsp;
                {%- endif -%}
                {%- if section.settings.show_author -%}
                  {{ article.author }}
                {%- endif -%}
              </p>
            {%- endif -%}
            {%- if section.settings.show_excerpt -%}
              <p class="blog-listing__excerpt">{{ article.excerpt | strip_html | truncatewords: 30 }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p>{{ 'blogs.blogs.article.no_articles' | t }}</p>
  {%- endif -%}
</div>

<style>
  .blog-listing {
    padding: 2rem 1rem;
  }
  .blog-listing__heading {
    text-align: center;
    margin-bottom: 2rem;
  }
  .blog-listing__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(var(--bl-cols-mobile), 1fr);
  }
  @media (min-width: 768px) {
    .blog-listing__grid {
      grid-template-columns: repeat(var(--bl-cols-desktop), 1fr);
    }
  }
  .blog-listing__item {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 4px;
    overflow: hidden;
  }
  .blog-listing__image-link {
    display: block;
    overflow: hidden;
  }
  .blog-listing__image {
    width: 100%;
    height: auto;
    display: block;
  }
  .blog-listing__content {
    padding: 1rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-listing__title {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .blog-listing__title a {
    text-decoration: none;
    color: inherit;
  }
  .blog-listing__meta {
    font-size: 0.875rem;
    color: #666;
    margin-bottom: 0.5rem;
  }
  .blog-listing__excerpt {
    flex-grow: 1;
    margin: 0;
    color: #444;
  }
</style>

{% schema %}
{
  "name": "Blog listing",
  "tag": "section",
  "class": "section section--blog-listing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest posts"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_per_row",
      "label": "Posts per row (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "posts_count",
      "label": "Number of posts to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "3-column listing",
      "category": "Blog",
      "settings": {
        "heading": "From the blog",
        "blog": "news",
        "posts_per_row": 3,
        "posts_count": 3,
        "show_author": true,
        "show_date": true,
        "show_excerpt": true
      }
    },
    {
      "name": "2-column listing",
      "category": "Blog",
      "settings": {
        "heading": "From the blog",
        "blog": "news",
        "posts_per_row": 2,
        "posts_count": 4,
        "show_author": true,
        "show_date": true,
        "show_excerpt": true
      }
    }
  ]
}
{% endschema %}