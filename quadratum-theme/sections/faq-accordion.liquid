{%- comment -%}
  FAQ Accordion Section

  This section outputs a series of frequently asked questions.  Each
  question/answer pair can be rendered in an accordion style where
  answers toggle open and closed, or in a simple list where all
  answers are visible at once.  The merchant can choose a heading,
  colour scheme, and whether the first item should be opened on
  load.  Accessibility is supported via appropriate ARIA attributes
  on buttons and panels.
{%- endcomment -%}

<div id="faq-{{ section.id }}" class="faq" style="--faq-bg: {{ section.settings.background_color }}; --faq-text: {{ section.settings.text_color }};" role="region" aria-label="Frequently Asked Questions">
  {%- if section.settings.heading != blank -%}
    <h2 class="faq__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- assign display_style = section.settings.style -%}
  <div class="faq__list faq__list--{{ display_style }}">
    {%- for block in section.blocks -%}
      <div class="faq__item" {{ block.shopify_attributes }}>
        {%- assign expanded = false -%}
        {%- if section.settings.open_first and forloop.first -%}
          {%- assign expanded = true -%}
        {%- endif -%}
        <button class="faq__question" type="button" id="faq-q-{{ section.id }}-{{ forloop.index }}" aria-controls="faq-a-{{ section.id }}-{{ forloop.index }}" aria-expanded="{{ expanded }}">
          {%- if block.settings.icon != blank -%}
            <span class="faq__icon">{{ block.settings.icon | image_url: width: 32 | image_tag: class: 'faq__icon-img', loading: 'lazy', alt: '' }}</span>
          {%- endif -%}
          <span class="faq__question-text">{{ block.settings.question }}</span>
          <span class="faq__toggle-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq__answer" id="faq-a-{{ section.id }}-{{ forloop.index }}" role="region" aria-labelledby="faq-q-{{ section.id }}-{{ forloop.index }}"{% unless expanded %} hidden{% endunless %}>
          {{ block.settings.answer }}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <style>
    .faq {
      background-color: var(--faq-bg);
      color: var(--faq-text);
      padding: 2rem 1rem;
    }
    .faq__heading {
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .faq__item {
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      padding: 1rem 0;
    }
    .faq__question {
      width: 100%;
      background: none;
      border: 0;
      padding: 0;
      text-align: left;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      color: inherit;
    }
    .faq__question:focus {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }
    .faq__icon {
      margin-right: 0.5rem;
      display: flex;
      align-items: center;
    }
    .faq__icon-img {
      width: 1.5rem;
      height: 1.5rem;
      object-fit: contain;
    }
    .faq__toggle-icon {
      font-size: 1.25rem;
      transition: transform 0.2s ease;
    }
    .faq__answer {
      margin-top: 0.5rem;
    }
    .faq__answer[hidden] {
      display: none;
    }
    /* Rotate toggle icon when expanded */
    button[aria-expanded="true"] .faq__toggle-icon {
      transform: rotate(45deg);
    }
    /* Styles for list style: show answers always */
    .faq__list--list .faq__answer {
      display: block !important;
    }
    .faq__list--list .faq__question {
      cursor: default;
    }
    .faq__list--list button .faq__toggle-icon {
      display: none;
    }
  </style>

  <script>
    (function() {
      const sectionId = '{{ section.id }}';
      const list = document.querySelector(`#faq-${sectionId} .faq__list`);
      if (!list) return;
      const displayStyle = '{{ section.settings.style }}';
      if (displayStyle === 'list') {
        // All answers are visible; no JS required
        return;
      }
      list.addEventListener('click', function(event) {
        const button = event.target.closest('button.faq__question');
        if (!button) return;
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answerId = button.getAttribute('aria-controls');
        const answer = document.getElementById(answerId);
        // Collapse all open panels first
        list.querySelectorAll('button.faq__question[aria-expanded="true"]').forEach(function(openBtn) {
          openBtn.setAttribute('aria-expanded', 'false');
          const openAnswer = document.getElementById(openBtn.getAttribute('aria-controls'));
          if (openAnswer) openAnswer.hidden = true;
        });
        // If the clicked panel was not expanded, expand it
        if (!isExpanded) {
          button.setAttribute('aria-expanded', 'true');
          if (answer) answer.hidden = false;
        }
      });
    })();
  </script>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section section--faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Display style",
      "default": "accordion",
      "options": [
        { "value": "accordion", "label": "Accordion" },
        { "value": "list", "label": "List" }
      ]
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept returns within 30 days of purchase.</p>"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ accordion",
      "category": "Text",
      "settings": {
        "heading": "FAQs",
        "style": "accordion",
        "open_first": true,
        "background_color": "#FFFFFF",
        "text_color": "#333333"
      },
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}